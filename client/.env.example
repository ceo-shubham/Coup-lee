# Google OAuth Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# Format: xxxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Backend Server URL (Optional: only needed if frontend and backend are hosted on separate domains)
# Example: https://coup-le-server.onrender.com (leave empty if served unified or via proxy)
VITE_SERVER_URL=
