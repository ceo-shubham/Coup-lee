# Server Port
PORT=4000

# Client Origins for CORS (comma-separated, e.g. https://coup-le.vercel.app,http://localhost:5173 or * to reflect request origin)
CLIENT_ORIGIN=*


# Optional: Backblaze B2 Storage (If omitted, local ephemeral storage with auto-cleanup is used)
# B2_APPLICATION_KEY_ID=your_b2_key_id
# B2_APPLICATION_KEY=your_b2_app_key
# B2_BUCKET_NAME=coup-le-media
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# B2_REGION=us-east-005
